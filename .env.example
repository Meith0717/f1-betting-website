# Copy this file to .env and fill in your values.
# VAPID keys: generate with  python src/app/generate_vapid_keys.py  (local dev)
# or  openssl ecparam -genkey -name prime256v1 -out vapid_private.pem  etc.

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:you@example.com

# Optional — if unset, a key is generated and stored in src/instance/.secret_key (Docker volume)
# SECRET_KEY=

# Registration password for new accounts (default: f1betting2024)
# REGISTRATION_PASSWORD=
